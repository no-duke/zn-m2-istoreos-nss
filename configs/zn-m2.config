# ============================================================================
# 兆能 M2 (ZN M2) —— iStoreOS 25.12 原生 + NSS 硬件加速 配置
# 源码：istoreos/istoreos @ istoreos-25.12  （内核 6.12）
# ----------------------------------------------------------------------------
# 设计原则：
#   1. iStoreOS 原生 —— 保留熟悉的界面与 iStore 商店
#   2. NSS 驱动全开 —— IPQ6000 网络卸载，千兆跑满 CPU 不炸
#   3. 无 WiFi —— 用户不需要，且 ath11k 固件体积大
#   4. 精简 —— 128MB NAND overlay 有限，固件每瘦 1MB 可写空间多 1MB
# ============================================================================

# ---------------- 目标平台 ----------------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
# 多机型模式（与 iStoreOS 的 02_network 判断逻辑一致），只选 zn_m2
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y

# 不产 initramfs（省体积）
CONFIG_TARGET_ROOTFS_INITRAMFS=n

# ---------------- 去 WiFi ----------------
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074=n
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_hostapd-common=n
# zn_m2 的 DEVICE_PACKAGES 若硬编码 ipq-wifi-zn_m2（几十 KB 校准数据），
# 无法用 .config 排除，留着无害。

# ============================================================================
# 一、NSS 硬件加速 —— 本次移植的核心理由
# ----------------------------------------------------------------------------
# IPQ6000 的 NSS 把 NAT / PPPoE / 流量卸载从 CPU 转到协处理器。
# 不开 NSS → 千兆跑满 CPU 单核打满；开了 → CPU 占用个位数。
# 这些 kmod 由 diy-part1.sh 追加的 qosmio/nss-packages 源提供。
# ============================================================================
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
CONFIG_PACKAGE_kmod-qca-nss-cfi-cryptoapi=y
CONFIG_PACKAGE_kmod-qca-nss-macsec=y
CONFIG_PACKAGE_kmod-qca-nss-netlink=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-l2tpv2=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pptp=y
CONFIG_PACKAGE_kmod-qca-nss-drv-netlink=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tunipip6=y
CONFIG_PACKAGE_kmod-qca-nss-clients=y
CONFIG_PACKAGE_kmod-qca-nss-ecm-premium=y
CONFIG_PACKAGE_kmod-qca-ssdk=y
CONFIG_PACKAGE_kmod-qca-ssdk-hnat=y

# NSS 固件与工具（qosmio/nss-packages 固件包名是 nss-firmware，非 kmod）
CONFIG_PACKAGE_nss-firmware-ipq60xx=y
CONFIG_PACKAGE_nss-eip-firmware=y

# NSS 状态查看（LuCI 插件，直观看卸载是否生效）
CONFIG_PACKAGE_luci-app-nss-status=y

# ============================================================================
# 二、iStore 应用商店 —— iStoreOS 原生已含，显式选中确保
# ============================================================================
CONFIG_PACKAGE_luci-app-store=y

# ============================================================================
# 三、用户明确要求的刚需组件
# ============================================================================
# --- CPU 跑分 ---
CONFIG_PACKAGE_coremark=y
# --- CPU 频率 / 状态 ---
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y
# --- 温度监控（CPU 温度趋势：cpufreq 主页实时温度 + collectd thermal 历史趋势图）---
# LuCI 统计页（rrdtool 约 +1~1.5MB）；如要极致精简可仅保留 cpufreq 的实时温度而注释本段
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_collectd-mod-thermal=y
CONFIG_PACKAGE_collectd-mod-cpu=y
CONFIG_PACKAGE_collectd-mod-memory=y
CONFIG_PACKAGE_collectd-mod-interface=y
# --- ZeroTier 内网穿透 ---
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y
# --- 流量监控 ---
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y

# ============================================================================
# 四、代理方案（省空间路线）
# ----------------------------------------------------------------------------
# HomeProxy 基于 sing-box，本体随包编译，不需要额外下载内核，不占 overlay。
# OpenClash 故意不预装 —— 需单独下载 15-35MB mihomo 内核，留给用户按需装。
# ============================================================================
CONFIG_PACKAGE_luci-app-homeproxy=y
# HomeProxy 后端本体（由 diy-part1.sh 注入的 immortalwrt/homeproxy feed 提供）
# 必须显式选中后端，否则前端 luci-app-homeproxy 会因依赖缺失被静默丢弃
CONFIG_PACKAGE_homeproxy=y
CONFIG_PACKAGE_sing-box=y

# ============================================================================
# 五、网络基础（PPPoE 拨号 + 硬件加速）
# ============================================================================
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-ipt=y
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-conntrack=y
CONFIG_PACKAGE_kmod-ipt-filter=y
CONFIG_PACKAGE_kmod-ipt-ipset=y
CONFIG_PACKAGE_kmod-ipt-raw=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_firewall4=y

# ============================================================================
# 六、存储 / USB（硬改 USB 3.0，为 extroot 预留）
# ============================================================================
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_mtd-utils=y
CONFIG_PACKAGE_nand-utils=y

# ============================================================================
# 七、常用工具
# ============================================================================
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-filetransfer=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ddns=y

# ============================================================================
# 八、界面
# ============================================================================
CONFIG_LUCI_LANG_zh_Hans=y

# ============================================================================
# 九、明确剔除的大体积包（PCDN / Docker / 重型下载等）
# ============================================================================
# --- Docker 全家桶：zn_m2 rootfs 有限，默认不预装，按需商店安装 ---
# CONFIG_PACKAGE_docker is not set
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_luci-app-docker is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# --- 重型下载/媒体 ---
# CONFIG_PACKAGE_luci-app-qbittorrent is not set
# CONFIG_PACKAGE_luci-app-transmission is not set
# CONFIG_PACKAGE_luci-app-aria2 is not set
# --- 重型应用 ---
# CONFIG_PACKAGE_python3 is not set
# CONFIG_PACKAGE_luci-app-adguardhome is not set
# CONFIG_PACKAGE_luci-app-alist is not set

# ============================================================================
# 十、编译选项
# ============================================================================
CONFIG_CCACHE=y
CONFIG_STRIP_KERNEL_EXPORTS=y
# CONFIG_USE_MKLIBS is not set
